# ConfigIQ Environment Configuration (Air-Gapped / On-Premise)

# Server Config
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=on-premise / air-gapped
DEBUG=True

# LLM Provider Configuration (mock / ollama)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434

# Sovereign Open-Weight Model Registry
GENERAL_MODEL=llama3:latest
CODING_MODEL=qwen2.5-coder:7b
CODING_HEAVY_MODEL=qwen2.5-coder:14b
EMBEDDING_MODEL=nomic-embed-text
VISION_MODEL=

# Storage Paths
STORAGE_DIR=./outputs/storage
KNOWLEDGE_BASE_DIR=./knowledge_base
LOGS_DIR=./logs
SANDBOX_DIR=./sandbox

# OCR Config
TESSERACT_PATH=
