# ==============================================================================
# Sovereign AI Industrial Agent Workbench - Environment Configuration
# ==============================================================================
# Copy this template to .env before starting the backend:
#   cp .env.example .env     (Linux/macOS)
#   copy .env.example .env   (Windows)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Network Settings
# ------------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=on-premise / air-gapped
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Local Open-Weight LLM & VLM Provider Configuration
# ------------------------------------------------------------------------------
# LLM_PROVIDER Options:
#   - 'ollama' : Production local mode using Ollama inference daemon (Recommended)
#   - 'mock'   : Zero-dependency synthetic fallback mode for fast testing without GPU
LLM_PROVIDER=ollama

# Ollama Host URL:
#   - Local native execution: http://localhost:11434
#   - Docker Compose container: http://ollama:11434 or http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------------------------
# 3. Model Registry & Dynamic Task Routing Matrix
# ------------------------------------------------------------------------------
# Recommended local open-weight models to pull with Ollama:
#   ollama pull llama3:latest            (or llama3.2:3b, mistral:7b)
#   ollama pull qwen2.5-coder:7b         (or deepseek-coder-v2:16b)
#   ollama pull qwen2.5-coder:14b        (or qwen2.5-coder:32b)
#   ollama pull nomic-embed-text         (or bge-m3, all-minilm)
#   ollama pull moondream                (or llava:7b, llama3.2-vision:11b)

# General Reasoning & Inspection Synthesizer Model
GENERAL_MODEL=llama3:latest

# Fast Code Execution & Physics Math Model
CODING_MODEL=qwen2.5-coder:7b

# Heavy Engineering Calculation & Advanced Simulation Model
CODING_HEAVY_MODEL=qwen2.5-coder:14b

# Local Embedding Model for Knowledge Base Vector Store
EMBEDDING_MODEL=nomic-embed-text

# Multimodal Visual Defect Inspection Model
VISION_MODEL=moondream

# ------------------------------------------------------------------------------
# 4. Storage & Artifact Directories (Relative or Absolute Paths)
# ------------------------------------------------------------------------------
STORAGE_DIR=./outputs/storage
KNOWLEDGE_BASE_DIR=./knowledge_base
LOGS_DIR=./logs
SANDBOX_DIR=./sandbox

# ------------------------------------------------------------------------------
# 5. Offline Optical Character Recognition (OCR) Engine
# ------------------------------------------------------------------------------
# Path to local Tesseract OCR binary (leave empty to use system PATH auto-detection):
# Windows example : C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example   : /usr/bin/tesseract
TESSERACT_PATH=
