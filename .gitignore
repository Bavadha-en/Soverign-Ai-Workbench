# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/

# Node / Frontend
node_modules/
frontend/node_modules/
dist/
# The built console IS shipped: the backend serves it, so a demo machine
# needs no Node toolchain. Rebuild with 'npm run build' after frontend edits.
!frontend/dist/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
.pytest_cache/
.coverage
htmlcov/

# Environment variables
.env
*.local

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Sandbox temporary outputs
sandbox/workspace/*
!sandbox/workspace/.gitkeep

# Temporary scratch scripts
scratch_*.py
scratch/


# Outputs and Logs
outputs/*
!outputs/.gitkeep
logs/*
!logs/.gitkeep
