# ====================================================================
# ConfigIQ Sovereign On-Premise Agentic AI Workbench - Backend Docker
# Air-Gapped / Sovereign Deployment (Problem Statement 26117)
# ====================================================================

FROM python:3.11-slim

# Prevent Python from writing .pyc files and enable unbuffered output
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    SOVEREIGN_MODE=true \
    OLLAMA_BASE_URL=http://host.docker.internal:11434

# Install essential system dependencies (Tesseract OCR, Poppler for PDF processing)
RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    tesseract-ocr-eng \
    poppler-utils \
    curl \
    gcc \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy requirements and install python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend codebase and required directories
COPY backend/ ./backend/
COPY knowledge_base/ ./knowledge_base/

# Ensure output directories exist with proper permissions
RUN mkdir -p outputs/storage logs sandbox

# Expose backend port
EXPOSE 8000

# Health check to ensure service readiness
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Launch backend via Uvicorn on 0.0.0.0:8000 inside the container only;
# docker-compose publishes it to the host on 127.0.0.1
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000"]
