# ====================================================================
# ConfigIQ Sovereign On-Premise Agentic AI Workbench - Frontend Docker
# Multi-stage production build (Node 20 -> Nginx Alpine)
# ====================================================================

# Step 1: Build stage
FROM node:20-alpine AS build

WORKDIR /app

# Copy dependency manifests
COPY frontend/package*.json ./

# Install dependencies (strictly offline/local if cached, standard install)
RUN npm install

# Copy frontend source
COPY frontend/ ./

# Build production assets with local backend URL default
ENV VITE_API_BASE_URL=http://localhost:8000
RUN npm run build

# Step 2: Production Nginx serving stage
FROM nginx:alpine

# Copy built static files to nginx html root
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom nginx configuration for SPA routing
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Expose standard frontend port
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
